[Unit]
Description=Mizito to Hermes Telegram webhook forwarder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=MIZITO_HOME=/home/siamak/.config/mizito
Environment=MIZITO_ALLOW_SEND=0
EnvironmentFile=/home/siamak/code/mizito-channel/deploy/mizito-hermes-telegram.env
ExecStart=/home/siamak/code/mizito-channel/dist/mizito hermes-watch
Restart=on-failure
RestartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/siamak/.config/mizito
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
